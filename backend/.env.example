APP_NAME=FlipLens AI
APP_VERSION=1.2.0

# mock = no external API; gemini = real image analysis
AI_PROVIDER=mock

# Create a fresh key in Google AI Studio. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_MAX_ATTEMPTS=3
AI_TIMEOUT_SECONDS=120


# Pricing: mock or ebay
PRICING_PROVIDER=mock
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_GB
EBAY_SCOPE=https://api.ebay.com/oauth/api_scope
EBAY_RESULT_LIMIT=50

# Free analyses per visitor per day (UTC). 0 = unlimited (use locally).
FREE_DAILY_LIMIT=5
# Reverse proxies in front of the API (Railway/Render = 1, local = 0)
TRUSTED_PROXY_HOPS=1

# Comma-separated frontend URLs allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
